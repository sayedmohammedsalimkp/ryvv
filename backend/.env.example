APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated. In production set ONLY your real site URL(s).
# Dev auto-adds localhost + 127.0.0.1:3000 when APP_ENV is not production.
FRONTEND_URL=http://localhost:3000

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Same as frontend NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Dashboard → API Keys → Secret key (sb_secret_... or legacy service_role)
# NOT the publishable key
SUPABASE_SECRET_KEY=sb_secret_...

# Optional
SUPABASE_JWT_SECRET=

# --- Telegram + Groq ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change-me
# webhook | polling | off
# Use polling for local Windows/dev (no ngrok). Use webhook in production.
TELEGRAM_MODE=polling

GROQ_API_KEY=
# openai/gpt-oss-20b (fast) or openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Observability (optional) ---
# Create a free project at https://sentry.io — paste the DSN here.
# Leave blank to disable.
SENTRY_DSN=
# Optional release tag, e.g. git sha
SENTRY_RELEASE=
